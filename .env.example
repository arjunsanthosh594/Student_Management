# ============================================================
# Student Management System - Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# --------------------------
# Flask Core
# --------------------------
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-key

# --------------------------
# Database (Local MySQL)
# --------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=student_management_db
DB_USER=root
DB_PASSWORD=your_mysql_password

# --------------------------
# Database (Amazon RDS - Production)
# --------------------------
# RDS_HOST=your-rds-endpoint.rds.amazonaws.com
# RDS_PORT=3306
# RDS_NAME=student_management_db
# RDS_USER=admin
# RDS_PASSWORD=your_rds_password

# --------------------------
# Amazon S3
# --------------------------
# In production, use an EC2 IAM Role — do NOT set these on EC2.
# For local development only:
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket-name

# --------------------------
# File Upload
# --------------------------
MAX_CONTENT_LENGTH=5242880
UPLOAD_FOLDER=app/static/images/uploads

# --------------------------
# Session / Cookie Security
# --------------------------
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600
