# ==========================================
# Flask Configuration
# ==========================================

SECRET_KEY=replace_with_a_strong_random_secret_key

# Your website currently uses HTTP
SESSION_COOKIE_SECURE=False


# ==========================================
# AWS RDS MySQL Database Configuration
# ==========================================

RDS_HOST=your-rds-endpoint.region.rds.amazonaws.com
RDS_PORT=3306
RDS_NAME=student_management
RDS_USER=admin
RDS_PASSWORD=your_actual_rds_password


# ==========================================
# AWS S3 Configuration
# ==========================================

AWS_REGION=ap-south-1
S3_BUCKET_NAME=your-actual-s3-bucket-name