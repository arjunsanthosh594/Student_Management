# ============================================================
# Systemd Service Definition for Student Management System
# Place in: /etc/systemd/system/sms.service
# ============================================================

[Unit]
Description=Student Management System - Gunicorn
After=network.target

[Service]
User=ubuntu
Group=www-data

WorkingDirectory=/home/ubuntu/Student_Management

Environment="PATH=/home/ubuntu/Student_Management/venv/bin"
Environment="FLASK_ENV=production"

EnvironmentFile=/home/ubuntu/Student_Management/.env

ExecStart=/home/ubuntu/Student_Management/venv/bin/gunicorn \
    --config /home/ubuntu/Student_Management/deploy/gunicorn.conf.py \
    run:app

Restart=always
RestartSec=5

PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
